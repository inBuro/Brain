.DS_Store
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/obsidian-git/.git_credentials_input
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/
*.tmp
.gstack/

# Claude Code worktrees — independent git repos under .claude/worktrees/, never embed as submodules
**/.claude/worktrees/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
**/credentials.json
**/secrets.json
.dev.vars
# GCP service-account keys (live GSC domain-owner key, see reference_gsc_api_access memory)
**/gen-lang-client-*.json

# Brain sync logs — generated by scripts/sync-from-main.sh via launchd
scripts/sync.log
scripts/sync.err.log
# Trigger-listener logs + cloud-side secret config
scripts/sync-trigger.log
scripts/sync-trigger.err.log
scripts/.trigger.env

# Large rebuildable build artifacts + dated bundle backups — keep on disk, NEVER commit.
# These exceeded GitHub's 100MB/file limit and silently broke autobackup for ~3 weeks;
# history was cleaned with git-filter-repo on 2026-06-17. Bundles rebuild from dist/ source.
fadercraft/Control XL/dist/*.zip
fadercraft/Control XL/raw/archive/*.zip
fadercraft/Control XL/raw/Demo-set Project/Samples/Processed/Crop/Melody 1 28 *.aif

# Same failure mode again, different files: ScreenStudio recording caches and Ableton
# project audio/backups silently pushed local history to 2.1GB in one commit, breaking
# autobackup for over a week (2026-08-08 to 2026-08-16). History of the affected
# (never-pushed) commits was squashed 2026-08-16; these patterns prevent recurrence.
**/*.screenstudio/
**/Samples/Imported/
**/Samples/Recorded/
**/Backup/

# Python venv + bytecode caches inside agent tools — rebuildable, never commit
**/.venv/
**/__pycache__/

# Промежуточные файлы проектов — пересобираются, никогда не коммитятся
**/.tmp/
