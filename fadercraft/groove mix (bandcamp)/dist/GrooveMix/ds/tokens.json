{
  "color": {
    "neutral": {
      "0": "#000000",
      "50": "#101010",
      "100": "#1a1a1a",
      "150": "#1e1e1e",
      "200": "#222222",
      "250": "#242424",
      "300": "#262626",
      "350": "#2c2c2c",
      "400": "#333333",
      "450": "#3c3c3c",
      "500": "#444444",
      "550": "#4a4a4a",
