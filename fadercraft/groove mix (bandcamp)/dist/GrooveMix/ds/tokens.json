      "650": "#888888",
      "700": "#999999",
      "800": "#cccccc",
      "850": "#eeeeee",
      "900": "#ffffff"
    },
    "brand": {
      "deckA": "#99ccff",
      "deckB": "#ffcc99"
    },
    "semantic": {
      "bg-app": "{neutral.100}",
      "bg-recessed": "{neutral.50}",
      "bg-panel": "{neutral.250}",
      "bg-panel-hover": "{neutral.300}",
      "bg-elevated": "{neutral.350}",
      "border-default": "{neutral.400}",
      "border-strong": "{neutral.0}",
      "text-heading": "{neutral.900}",
      "text-primary": "{neutral.850}",
      "text-secondary": "{neutral.700}",
      "text-tertiary": "{neutral.650}",
      "text-muted": "{neutral.600}",
      "accent-deckA": "{brand.deckA}",
      "accent-deckB": "{brand.deckB}",
      "success": "#22aa55",
      "success-active": "#119944",
      "success-glow": "#66cc66",
      "selection-bg": "#243a5b",
      "cue-segment": "#3d6fe5",
      "cue-active": "#c3e05a"
    }
  },
  "space": {
    "4": 4,
    "5": 5,
    "6": 6,
    "8": 8,
    "10": 10,
    "12": 12,
    "16": 16,
    "20": 20,
    "40": 40
  },
  "radius": {
    "sm": 3,
    "md": 4,
    "lg": 6,
    "full": "50%"
  },
  "shadow": {
    "knob-rest": "inset 0 1px 2px color-mix(in srgb, var(--color-900) 10%, transparent), inset 0 -1px 2px color-mix(in srgb, var(--color-0) 60%, transparent), 0 2px 3px color-mix(in srgb, var(--color-0) 50%, transparent)",
    "knob-hover": "inset 0 1px 2px color-mix(in srgb, var(--color-900) 10%, transparent), inset 0 -1px 2px color-mix(in srgb, var(--color-0) 60%, transparent), 0 0 0 2px color-mix(in srgb, var(--color-900) 12%, transparent)",
    "fader-thumb": "inset 0 1px 0 color-mix(in srgb, var(--color-900) 15%, transparent), inset 0 -1px 0 color-mix(in srgb, var(--color-0) 40%, transparent), 0 1px 3px color-mix(in srgb, var(--color-0) 50%, transparent)",
    "glow-deckA": "0 0 4px color-mix(in srgb, var(--color-accent-deckA) 70%, transparent)",
    "glow-deckA-strong": "0 0 4px color-mix(in srgb, var(--color-accent-deckA) 80%, transparent)",
    "glow-deckB": "0 0 4px color-mix(in srgb, var(--color-accent-deckB) 70%, transparent)",
    "glow-deckB-strong": "0 0 4px color-mix(in srgb, var(--color-accent-deckB) 80%, transparent)"
  },
  "typography": {
    "family": {
      "ui": "-apple-system, system-ui, sans-serif"
    },
    "style": {
      "2xs": {
        "size": "0.5625rem",
        "weight": 700
      },
      "xs": {
        "size": "0.625rem",
        "weight": 400
      },
      "sm": {
        "size": "0.6875rem",
        "weight": 400
      },
      "base": {
        "size": "0.75rem",
        "weight": 400
      },
      "md": {
        "size": "0.8125rem",
        "weight": 400
      },
      "lg": {
        "size": "0.875rem",
        "weight": 700
      }
    }
  }
}
